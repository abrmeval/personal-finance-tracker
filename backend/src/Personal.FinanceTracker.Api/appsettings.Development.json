{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "<postgres_connection_string>"
  },
  "Jwt": {
    "SecretKey": "<jwt_secret_key>",
    "Issuer": "<jwt_issuer>",
    "Audience": "<jwt_audience>",
    "ExpiryMinutes": 60
  },
  "AllowedHosts": "*"
}